# ====================================================
# Daily Lumos — Firebase 環境變數設定
# ====================================================
# 複製此檔案為 .env（或 .env.local）並填入你的 Firebase 設定值
# cp .env.example .env
#
# 取得方式:
#   1. 前往 https://console.firebase.google.com
#   2. 建立或選擇專案
#   3. 專案設定 > 你的應用程式 > Firebase SDK 設定 > 設定值
#
# Firebase 需開啟的服務:
#   - Authentication > 登入方式 > Google（啟用）
#   - Firestore Database（建立，選擇 production 模式）
# ====================================================

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 每日推播（FCM）— 前端用
# Firebase Console > 專案設定 > Cloud Messaging > 網頁推送憑證 > 產生金鑰對
# 把「金鑰對」那串公開金鑰填在這裡
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# ── 以下為「推播發送端」用，只需設在 Vercel 環境變數，不必放本地 .env ──
# FIREBASE_SERVICE_ACCOUNT — Firebase 服務帳戶私密金鑰 JSON（整段貼上）
# CRON_SECRET              — 自訂密鑰，需與 GitHub repo secret 一致
#
# ── 測試用，「只」設在 Vercel Preview 環境，正式環境(Production)不要設 ──
# VITE_ENABLE_PUSH_TEST=true   — 顯示「發送測試通知」按鈕（前端）
# ENABLE_PUSH_TEST=true        — 啟用 /api/test-push 端點（後端）
